{
  "private": true,
  "name": "vura",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/vite-plugin packages/adapter-lambda packages/adapter-cloudflare packages/adapter-vura packages/compiler packages/create-then",
    "test": "vitest run",
    "dev": "node packages/cli/dist/bin.js dev",
    "verify:publish": "node scripts/verify-publish.mjs",
    "lint": "node scripts/check-hygiene.mjs",
    "format": "node scripts/check-hygiene.mjs",
    "check": "pnpm run lint && pnpm run build",
    "audit": "pnpm audit --prod",
    "verify:registry": "node scripts/verify-registry-install.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.1",
    "vitest": "^3.0.0",
    "wrangler": "^4.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  },
  "dependencies": {
    "what-core": "^0.8.1",
    "what-framework": "^0.8.1"
  },
  "license": "MIT"
}
