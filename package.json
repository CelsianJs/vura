{
  "private": true,
  "name": "vura",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/vite-plugin packages/adapter-lambda packages/adapter-cloudflare packages/adapter-vura packages/compiler packages/create-vura",
    "test": "vitest run",
    "dev": "node packages/cli/dist/bin.js dev",
    "verify:publish": "node scripts/verify-publish.mjs",
    "lint": "node scripts/check-hygiene.mjs",
    "format": "node scripts/check-hygiene.mjs",
    "check": "pnpm run assert:release-private && pnpm run lint && pnpm run build",
    "audit": "pnpm audit --prod",
    "verify:registry": "node scripts/verify-registry-install.mjs",
    "assert:release-private": "node scripts/assert-release-private.mjs",
    "release:check": "node scripts/release-check.mjs",
    "package:size": "node scripts/check-package-size.mjs",
    "docs:build": "npm --prefix docs-site run build",
    "test:selfhost-audit": "vitest run tests/self-host-audit"
  },
  "devDependencies": {
    "@types/node": ">=20 <27",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.2",
    "typescript": "^6.0.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.102.0",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ],
    "overrides": {
      "@types/node": "26.1.0"
    }
  },
  "dependencies": {
    "what-core": "^0.11.6",
    "what-framework": "^0.11.1"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20 <23"
  }
}
