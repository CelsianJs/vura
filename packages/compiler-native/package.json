{
  "name": "@celsian/then-compiler-native",
  "version": "0.1.2",
  "description": "Unpublished native Rust compiler prototype for Vura — source-only until platform binaries are released",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "compiler-native",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "license": "MIT",
  "private": true,
  "optionalDependencies": {
    "@celsian/then-compiler-native-darwin-arm64": "0.1.2",
    "@celsian/then-compiler-native-linux-arm64-gnu": "0.1.2",
    "@celsian/then-compiler-native-linux-arm64-musl": "0.1.2",
    "@celsian/then-compiler-native-linux-x64-musl": "0.1.2"
  }
}