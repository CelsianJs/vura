{
  "name": "@celsian/vura-compiler-native",
  "version": "0.8.0",
  "description": "Unpublished native Rust compiler prototype for Vura \u2014 source-only until platform binaries are released",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "compiler-native",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "license": "MIT",
  "private": true
}
