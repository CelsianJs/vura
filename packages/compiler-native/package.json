{
  "name": "@then/compiler-native",
  "version": "0.1.0",
  "description": "Unpublished native Rust compiler prototype for ThenJS — source-only until platform binaries are released",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "compiler-native",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@then/compiler-native-win32-x64-msvc": "0.1.0",
    "@then/compiler-native-darwin-x64": "0.1.0",
    "@then/compiler-native-linux-x64-gnu": "0.1.0",
    "@then/compiler-native-darwin-arm64": "0.1.0",
    "@then/compiler-native-linux-arm64-gnu": "0.1.0",
    "@then/compiler-native-linux-arm64-musl": "0.1.0",
    "@then/compiler-native-linux-x64-musl": "0.1.0"
  },
  "private": true
}
