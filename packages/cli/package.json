{
  "name": "@celsian/vura-cli",
  "version": "0.5.14",
  "description": "Vura CLI — build and deploy full-stack apps",
  "type": "module",
  "bin": {
    "vura": "bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin.js",
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@celsian/vura-core": "workspace:0.5.14",
    "esbuild": "^0.28.1",
    "what-framework": "^0.13.2"
  },
  "peerDependencies": {
    "@celsian/vura-adapter-vura": "0.5.14",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@celsian/vura-adapter-vura": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@celsian/vura-adapter-vura": "workspace:0.5.14",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelsianJs/vura.git"
  },
  "homepage": "https://github.com/CelsianJs/vura#readme",
  "bugs": {
    "url": "https://github.com/CelsianJs/vura/issues"
  },
  "keywords": [
    "vura",
    "cli",
    "full-stack",
    "deployment",
    "typescript"
  ],
  "engines": {
    "node": ">=20 <23"
  }
}
