{
  "name": "@celsian/vura-cli",
  "version": "0.2.0",
  "description": "Vura CLI — build and deploy full-stack apps",
  "type": "module",
  "bin": {
    "vura": "bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin.js",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@celsian/vura-core": "workspace:0.2.0",
    "esbuild": "^0.27.3",
    "what-framework": "^0.11.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelsianJs/vura.git"
  },
  "homepage": "https://github.com/CelsianJs/vura#readme",
  "bugs": {
    "url": "https://github.com/CelsianJs/vura/issues"
  },
  "keywords": [
    "vura",
    "cli",
    "full-stack",
    "deployment",
    "typescript"
  ],
  "engines": {
    "node": ">=20 <23"
  }
}
