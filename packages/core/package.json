{
  "name": "@celsian/vura-core",
  "version": "0.7.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@celsian/core": "^0.6.1",
    "@celsian/jwt": "^0.6.1",
    "@celsian/vura-compiler": "workspace:0.7.0",
    "esbuild": "^0.28.1",
    "what-framework": "^0.13.4",
    "what-isr": "^0.13.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Vura core runtime and build pipeline for full-stack TypeScript apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelsianJs/vura.git"
  },
  "homepage": "https://github.com/CelsianJs/vura#readme",
  "bugs": {
    "url": "https://github.com/CelsianJs/vura/issues"
  },
  "keywords": [
    "vura",
    "celsian",
    "full-stack",
    "serverless",
    "static-site",
    "typescript"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.0"
  }
}
