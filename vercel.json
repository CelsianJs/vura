{
  "buildCommand": "npm --prefix docs-site install && npm --prefix docs-site run build",
  "outputDirectory": "docs-site/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/login",
      "destination": "https://app.vura.io",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://app.vura.io",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://app.vura.io",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/ladder/0-create",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/reference/:path*",
      "permanent": false
    },
    {
      "source": "/ladder",
      "destination": "/ladder/0-create",
      "permanent": false
    },
    {
      "source": "/reference",
      "destination": "/reference/config",
      "permanent": false
    }
  ]
}
